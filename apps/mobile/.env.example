# Copy to .env and adjust as needed. Expo only exposes vars prefixed
# EXPO_PUBLIC_ to client code (see src/firebase/config.ts).

# Default is "true" even if unset -- only set to "false" once a real
# Firebase project exists (founder action, see docs/architecture-v1.md §6).
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true

# 127.0.0.1 works for `expo start --web`, iOS Simulator, and Android
# Emulator. On a PHYSICAL DEVICE, 127.0.0.1 means the phone itself, not your
# laptop -- set this to your dev machine's LAN IP (e.g. 192.168.1.23) and
# make sure the Firebase emulators were started with that IP reachable
# (firebase.json's emulators already bind all interfaces by default).
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# --- Real Firebase project config (founder action, later, config-only) ---
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
